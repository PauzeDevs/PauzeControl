<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <solid android:color="#5847E8" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <item>
        <shape>
            <gradient
                android:angle="0"
                android:startColor="#7C5CFF"
                android:endColor="#4C8DFF" />
            <corners android:radius="18dp" />
        </shape>
    </item>
</selector>